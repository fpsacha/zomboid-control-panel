# Zomboid Control Panel - environment variable reference
#
# All variables are optional. The panel runs with sensible defaults if none are set.
# Most settings can also be edited from the UI (Settings page) once you're logged in.
#
# Usage:
#   - Docker (docker-compose.yml, the bind-mount path): drop this file next
#     to it as `.env`. Using docker/all-in-one instead? It has its own,
#     separate .env.example with different variables — see
#     docker/all-in-one/.env.example and docs/install/docker.md.
#   - Linux service: add `Environment=KEY=value` lines to zomboid-panel.service
#   - Windows: set them in your shell before running ZomboidControlPanel.exe

# Open the panel in the default browser when a packaged executable starts.
# Set to false when the panel is launched by a service or you already keep a
# browser tab open. Default: true.
# PANEL_AUTO_OPEN_BROWSER=true

# --- Docker permissions ---
# Docker only: numeric UID/GID used by the panel process. Match these to the
# owner of any PZ directories bind-mounted into the panel container. The image
# re-owns only /app/data and /app/logs; it never changes ownership of game mounts.
PUID=1000
PGID=1000

# Optional Docker lifecycle control for a PZ container on this Docker host.
# Requires the docker.sock bind mount and matching supplementary socket group
# described in docker-compose.yml and docs/install/docker.md. The PZ
# container must carry the label zomboid-panel.managed=true, and its name or
# ID must be set in Settings > Servers > Docker container.
# PANEL_DOCKER_CONTROL_ENABLED=false
# DOCKER_GID=999

# --- Network ---

# Port the panel HTTP server binds to. Default: 3001.
PORT=3001

# Override the LAN and WAN addresses displayed by the dashboard. These are
# needed when the panel runs in Docker, where automatic interface detection
# only sees the Docker bridge address (for example, 172.17.0.4).
# If the panel process can see multiple real interfaces (e.g. running
# directly on a host with both Tailscale and ZeroTier), prefer Settings >
# Network > Dashboard LAN Address instead — no restart required.
# PANEL_LAN_IP=192.168.1.10
# PANEL_WAN_IP=203.0.113.10

# Comma-separated list of additional allowed CORS origins.
# Required when the panel is reached via a public hostname behind a reverse proxy.
# Example: https://panel.example.com,https://admin.example.com
# CORS_ORIGINS=

# Set to "true" when the panel is served over HTTPS (typically by a reverse proxy).
# Enables HSTS and upgrade-insecure-requests headers.
# HTTPS=false

# Alias for HTTPS=true. Use either.
# FORCE_HSTS=false

# Trust client IP headers only when the panel is behind a known reverse proxy.
# Use a positive hop count, an IP/subnet, or a comma-separated list of IPs/subnets.
# Keep this false when clients connect directly to the panel. A hop count
# trusts whatever connects directly, so the panel warns at startup: name the
# proxy instead (loopback for nginx on this machine), or in Docker publish the
# port on 127.0.0.1 only (PANEL_BIND_ADDRESS below). Examples:
# TRUST_PROXY=loopback
# TRUST_PROXY=127.0.0.1,10.0.0.0/8
# TRUST_PROXY=1
TRUST_PROXY=false

# Docker only: the host address port 3001 is published on. Blank means every
# address, and Docker's published ports bypass UFW. Behind a reverse proxy on
# this host, set 127.0.0.1 so only the proxy can reach the panel. A proxy in
# another container: see docs/install/docker.md first.
# PANEL_BIND_ADDRESS=127.0.0.1

# --- Project Zomboid integration ---
# These can all be set from the UI later. Set them here only if you want the
# panel to come up pre-configured (e.g. in Docker or unattended deploys).

# Path to the PZ dedicated server install.
# In Docker, use the container-side path of your bind mount (e.g. /pz-server).
# PZ_SERVER_PATH=

# Path to the Zomboid user data folder (saves, config, Lua write path, server-console.txt).
# PanelBridge reads/writes JSON under <PZ_SAVE_PATH>/Lua/panelbridge/<serverName>/.
# In Docker, use the container-side path (e.g. /zomboid).
# PZ_SAVE_PATH=

# Startup script filename inside PZ_SERVER_PATH.
# Defaults: StartServer64.bat on Windows, start-server.sh on Linux.
# PZ_SERVER_BAT=start-server.sh

# --- RCON ---
# These are also configurable in Settings. Defaults match a stock PZ server.
# If panel + PZ are both in Docker: set this to your PZ service name (example: pzserver).
# Do NOT use 127.0.0.1 in that topology.
RCON_HOST=127.0.0.1
RCON_PORT=27015
# RCON_PASSWORD=
# Docker/Kubernetes secret file. Takes precedence over RCON_PASSWORD and the
# password saved in Settings, so the value is never persisted in db.json.
# It is only sent to this machine and RCON_HOST; a server on any other host
# uses the RCON password saved for that server.
# RCON_PASSWORD_FILE=/run/secrets/rcon_password

# Set to "true" to allow RCON connection attempts even when the panel thinks
# the server process is offline (useful for remote PZ servers managed elsewhere).
# RCON_SKIP_SERVER_CHECK=false

# --- Steam Workshop ---

# Optional Steam Web API key for richer mod metadata. Get one at:
#   https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=
# Docker/Kubernetes secret file. Takes precedence over STEAM_API_KEY and the
# key saved in Settings, so the value is never persisted in db.json.
# STEAM_API_KEY_FILE=/run/secrets/steam_api_key

# How often (ms) to poll the Workshop for mod updates. Default: 300000 (5 min).
# MOD_CHECK_INTERVAL=300000

# --- Scheduler ---

# Enable the legacy env-based auto-restart job. Most users should leave this
# disabled and use the in-app Scheduler page instead.
# AUTO_RESTART_ENABLED=false
# AUTO_RESTART_CRON=0 */6 * * *
# Warning countdown (minutes) before an automatic restart: 0 restarts at once, 1-60. Default 5.
# RESTART_WARNING_MINUTES=5

# --- OIDC / SSO login ---
# Optional. Adds a "Sign in with SSO" option ALONGSIDE local username/password
# login — local login always keeps working, even if these are unset,
# misconfigured, or the identity provider is unreachable. Works with any
# standards-compliant OpenID Connect provider (Google, Discord, Authentik,
# Keycloak, ...): point PANEL_OIDC_ISSUER_URL at the provider's issuer and
# the panel discovers the rest. All four are required together to enable it.
#
# Register PANEL_OIDC_REDIRECT_URI with your provider as the app's redirect
# URI — it must match exactly, e.g. https://panel.example.com/api/auth/oidc/callback
# PANEL_OIDC_ISSUER_URL=
# PANEL_OIDC_CLIENT_ID=
# PANEL_OIDC_CLIENT_SECRET=
# PANEL_OIDC_REDIRECT_URI=

# Requested OAuth scopes. Default covers standard profile/email claims.
# PANEL_OIDC_SCOPE=openid email profile

# Cosmetic only (e.g. "Sign in with Authentik" on the login button).
# PANEL_OIDC_PROVIDER_NAME=SSO

# Only for a self-hosted provider reachable solely over plain HTTP (e.g.
# behind a VPN/reverse proxy that terminates TLS elsewhere). Leave unset —
# the panel refuses to talk to an HTTPS-only-by-default provider over HTTP.
# PANEL_OIDC_ALLOW_INSECURE_HTTP=false

# --- Session signing ---

# The panel generates and manages its own signing key automatically on
# first run (saved to <data dir>/jwt.secret) — most installs never need to
# set this. Only needed to pin the same key across multiple panel instances
# sharing one database, or to inject it via a Docker/Kubernetes secret
# instead of a file on disk. Must be at least 32 random characters (e.g.
# `openssl rand -hex 32`) — the panel refuses to start with a shorter one.
# Setting either of these rotates every existing session on next restart.
# JWT_SECRET=
# Docker/Kubernetes secret file. Takes precedence over JWT_SECRET.
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# --- Logging ---

# Winston log level: error, warn, info, debug.
LOG_LEVEL=info

{
  "name": "pz-server-manager",
  "version": "1.2.12",
  "description": "Project Zomboid Server Manager - Web-based admin panel",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:exe": "node build.js",
    "build:exe:windows": "node build.js --windows",
    "build:exe:linux": "node build.js --linux",
    "build:exe:all": "node build.js --all",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install",
    "test": "vitest run server/tests && cd client && npx vitest run",
    "test:watch": "vitest server/tests",
    "test:server": "vitest run server/tests",
    "test:client": "cd client && npx vitest run",
    "lint:server": "eslint server eslint-rules --max-warnings=0",
    "ui:shot-tour": "node scripts/ui-shot-tour.mjs",
    "check:engine-signatures": "node scripts/check-engine-signatures.mjs",
    "gen:engine-signatures": "node scripts/gen-engine-signatures.mjs",
    "check:i18n-staleness": "node scripts/i18n-staleness-check.mjs",
    "check:bridge-actions": "node scripts/audit-bridge-actions.mjs .",
    "check:bridge-routes": "node scripts/audit-bridge-routes.mjs .",
    "check:rcon-commands": "node scripts/audit-rcon-commands.mjs .",
    "check:i18n": "node scripts/i18n-check.mjs --all"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^7.0.1",
    "node-cron": "^4.6.0",
    "openid-client": "^6.8.7",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.2",
    "ssh2-sftp-client": "^12.1.1",
    "undici": "^8.10.0",
    "unzipper": "^0.12.5",
    "uuid": "^13.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fengari": "^0.1.5",
    "globals": "^14.0.0",
    "jose": "^6.2.10",
    "nodemon": "^3.1.14",
    "playwright": "^1.62.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    }
  }
}
